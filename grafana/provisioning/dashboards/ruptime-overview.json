{
  "uid": "ruptime-overview",
  "title": "Ruptime / Uptime Overview",
  "description": "Availability, latency, TLS/domain expiry and group health from the ruptime /metrics endpoint.",
  "tags": [
    "ruptime",
    "uptime",
    "monitoring"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Went DOWN",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "(monitor_status{monitor_type=~\"$type\",monitor_name=~\"$monitor\"} == 0) and (monitor_status{monitor_type=~\"$type\",monitor_name=~\"$monitor\"} offset 1m == 1)",
        "step": "1m",
        "titleFormat": "{{monitor_name}} DOWN",
        "textFormat": "{{monitor_type}} {{monitor_hostname}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "options": [],
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "type",
        "label": "Type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(monitor_status, monitor_type)",
          "refId": "var-type",
          "qryType": 1
        },
        "definition": "label_values(monitor_status, monitor_type)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "description": "Filter by check type"
      },
      {
        "name": "monitor",
        "label": "Monitor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(monitor_status{monitor_type=~\"$type\"}, monitor_name)",
          "refId": "var-monitor",
          "qryType": 1
        },
        "definition": "label_values(monitor_status{monitor_type=~\"$type\"}, monitor_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "description": "Filter by monitor"
      }
    ]
  },
